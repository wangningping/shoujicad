{
  "name": "shoujicad-mobile-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first open-source CAD viewer (DXF/DWG), view-only",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:snap": "node scripts/snap-check.mjs",
    "verify:measure": "node scripts/measure-check.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap copy android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@mlightcad/libredwg-web": "^0.9.2",
    "dxf-parser": "^1.1.2",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
